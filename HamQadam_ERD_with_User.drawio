et="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c100" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c17" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c101" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c18" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c102" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c18" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c103" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c18" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c104" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c18" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c105" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c18" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c106" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c19" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c107" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c19" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c108" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c19" target="c57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c109" value="" style="endArrow=none;html=1;strokeColor=#cccccc;strokeWidth=1;labelBackgroundColor=#121212;fontColor=#ffffff;fontStyle=1;fontSize=11;" edge="1" parent="1" source="c19" target="c58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c110" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Rectangle = Entity&lt;br&gt;Double rectangle = Weak entity&lt;br&gt;Diamond = Relationship&lt;br&gt;Double diamond = Identifying relationship&lt;br&gt;Oval = Attribute&lt;br&gt;&lt;u&gt;Underlined&lt;/u&gt; = Primary key&lt;br&gt;Dashed underline = Partial key&lt;br&gt;Triangle (ISA) = Specialization of USER&lt;br&gt;Double line = Total participation&lt;br&gt;1 / M / N = Cardinality" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;strokeColor=#bbbbbb;fillColor=#1a1a1a;spacingLeft=8;spacingTop=6;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="69" y="1360" width="300" height="190" as="geometry"/></mxCell><mxCell id="c111" value="&lt;b&gt;Note:&lt;/b&gt; USER is the supertype holding the common attributes (UserID, Name, Email, Password, Role). STUDENT, ALUMNUS and ADMIN are its subtypes (disjoint: every user is exactly one of them) and inherit UserID as their key." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;strokeColor=#bbbbbb;fillColor=#1a1a1a;spacingLeft=8;spacingTop=6;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="69" y="1570" width="300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>